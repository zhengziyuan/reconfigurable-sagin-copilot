RSAGIN_HOST=127.0.0.1
RSAGIN_PORT=8000
RSAGIN_WEB_PORT=8080
RSAGIN_DATA_DIR=runs
VITE_API_BASE_URL=

# GIS providers. Public defaults are for interactive demos; replace them with
# a contracted or self-hosted tile service for commercial deployment.
VITE_GIS_STREET_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_GIS_STREET_ATTRIBUTION=© OpenStreetMap contributors
VITE_GIS_SATELLITE_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
VITE_GIS_SATELLITE_ATTRIBUTION=EOxCloudless https://cloudless.eox.at by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2020)

# Optional adapter configuration; these adapters are not selected by the default deployment.
POSTGRES_DSN=postgresql://rsagin:rsagin@localhost:5432/rsagin
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=rsagin-artifacts
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
